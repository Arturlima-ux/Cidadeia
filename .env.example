# Ambiente de execução
NODE_ENV=development

# Banco de dados (Postgres via Supabase)
# DATABASE_URL: connection string do POOLER (Settings → Database →
#   Connection string → aba "Transaction pooler", porta 6543) — usada pela
#   aplicação em runtime.
# DIRECT_URL: connection string DIRETA (mesma tela, aba "Session" / porta
#   5432) — usada só pelo drizzle-kit para gerar/aplicar migrations.
DATABASE_URL=postgresql://postgres.xxxxx:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xxxxx:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave secreta para autenticação (preencha no .env)
# Gere uma chave aleatória com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=troque-por-uma-string-aleatoria-longa-e-segura

# Chave da Anthropic (opcional)
# Necessária para usar a IA Central - obtenha em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Storage do Supabase (opcional — upload de foto de perfil)
# Project Settings → API → Project URL / service_role key (secreta, nunca
# exponha no front-end). Sem isso, o upload de foto fica desabilitado.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail transacional (opcional — recuperação de senha)
# Sem isso configurado, o link de redefinição só aparece no log do servidor.
# Crie uma conta grátis em https://resend.com, gere uma API key e verifique
# um domínio (ou use onboarding@resend.dev só para testes).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Links de contratação dos planos (opcionais; use valores reais em produção)
CHECKOUT_URL_SAUDE=
CHECKOUT_URL_EDUCACAO=
CHECKOUT_URL_OBRAS=
CHECKOUT_URL_LICITACOES=
CHECKOUT_URL_GESTAO=

# URL da aplicação em produção
NEXT_PUBLIC_APP_URL=http://localhost:3000