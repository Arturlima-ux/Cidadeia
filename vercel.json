{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/f/:arquivo",
      "destination": "https://cdn.jsdelivr.net/gh/Arturlima-ux/Cidadeia@4bf1faa5a77ccf82ae680fbe6c9b5b98141f2cfe/f/:arquivo"
    }
  ],
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/assets/f/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
